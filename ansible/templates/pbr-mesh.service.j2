[Unit]
Description=Policy Based Routing for Mesh Split Tunnel
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'ip rule add fwmark 0x100 lookup 100 2>/dev/null || true; ip route replace default via {{ default_gateway }} dev {{ default_interface }} table 100'
ExecStop=/bin/sh -c 'ip rule del fwmark 0x100 lookup 100 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
